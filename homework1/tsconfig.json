{
    "compilerOptions": {
        "target": "es6",
        "module": "es2015",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./javascript",
        "rootDir": "./src",
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", " javascript "]
}